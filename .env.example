# Public Convex Cloud deployment URL (baked into the client bundle at build time).
# Set automatically by the hybrid deploy; for local dev, `npx convex dev` writes it to .env.local.
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# --- set on the Convex deployment (NOT here), via `npx convex env set` ---
# JWT_PRIVATE_KEY  — RS256 PKCS8 private key for @convex-dev/auth
# JWKS             — matching public JWKS JSON
# SITE_URL         — https://frame-pilot.rahmanef.com
